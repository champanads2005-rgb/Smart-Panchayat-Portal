# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to source control.

SECRET_KEY=replace-with-a-long-random-value
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=smart_panchayat

# AI / ML
CLASSIFIER_CONFIDENCE_MIN=0.35

# Reserved for future Generative AI integration (not required for this phase)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Phase 7: image-based complaint detection
CV_CONFIDENCE_MIN=0.65
MAX_IMAGE_UPLOAD_BYTES=5242880
# UPLOAD_FOLDER defaults to ./uploads/complaint_images if unset

# Phase 8: voice complaint submission
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_AUDIO_DURATION_SECONDS=120
AUDIO_RETENTION_DAYS=90
# Leave unset to attempt downloading from Hugging Face Hub (requires
# network access this sandbox does not have - see ml/asr/data/README.md).
# Set to a local folder path if you have pre-downloaded Whisper weights.
WHISPER_MODEL_DIR=
WHISPER_MODEL_SIZE=tiny
